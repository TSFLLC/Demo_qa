CREATE OR ALTER VIEW dbo.v_Audit_All
AS
SELECT
  event_time,
  action_id,
  succeeded,
  server_principal_name,
  database_name,
  schema_name,
  object_name,
  statement,
  client_ip,
  application_name
FROM sys.fn_get_audit_file(N'R:\SQLAudit\TERA\*.sqlaudit', DEFAULT, DEFAULT);
GO
