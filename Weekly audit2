5A) PHI/HR SELECT view++++++++++++++++++++++++++++++++++++++

CREATE OR ALTER VIEW dbo.v_Audit_PHI_Selects
AS
SELECT *
FROM dbo.v_Audit_All
WHERE action_id = 'SL'  -- SELECT
  AND database_name = 'TERA';
GO
++++++++++++++++++5B) Failed logins (human-only)+++++++++++++++++++++

CREATE OR ALTER VIEW dbo.v_Audit_FailedLogins_Human
AS
SELECT
  event_time,
  server_principal_name AS login_name,
  client_ip,
  application_name,
  statement AS error_message,
  action_id,
  succeeded
FROM dbo.v_Audit_All
WHERE action_id IN ('LGIF')   -- login failed
  AND (server_principal_name IS NOT NULL AND server_principal_name <> '')
  AND server_principal_name NOT LIKE 'svc%'
  AND server_principal_name NOT LIKE 'NT SERVICE\%';
GO

++++++++5C) Table/Schema drops++++++++++++++++
CREATE OR ALTER VIEW dbo.v_Audit_TableDrops
AS
SELECT
  event_time,
  server_principal_name AS login_name,
  client_ip,
  application_name,
  database_name,
  schema_name,
  object_name,
  statement,
  action_id,
  succeeded
FROM dbo.v_Audit_All
WHERE action_id IN ('DR','DL')  -- DROP events (varies by audit config)
  AND database_name = 'TERA';
GO
