             THEN i.Answer20 ELSE 'Masked-' + RIGHT(CONVERT(varchar(40), ABS(CAST(CHECKSUM(i.Seed + '_A20') AS BIGINT))), 12) END
    FROM st i
    CROSS APPLY (
        SELECT
            MaskedBirthdate = DATEADD(DAY, ABS(CAST(CHECKSUM(i.Seed + '_DOB') AS BIGINT)) % 25550, CONVERT(date,'1940-01-01')),
            MaskedAge =
                DATEDIFF(YEAR,
                    DATEADD(DAY, ABS(CAST(CHECKSUM(i.Seed + '_DOB') AS BIGINT)) % 25550, CONVERT(date,'1940-01-01')),
                    CAST(GETDATE() AS date)
                )
                - CASE WHEN DATEADD(YEAR,
                        DATEDIFF(YEAR,
                            DATEADD(DAY, ABS(CAST(CHECKSUM(i.Seed + '_DOB') AS BIGINT)) % 25550, CONVERT(date,'1940-01-01')),
                            CAST(GETDATE() AS date)
                        ),
                        DATEADD(DAY, ABS(CAST(CHECKSUM(i.Seed + '_DOB') AS BIGINT)) % 25550, CONVERT(date,'1940-01-01'))
                    ) > CAST(GETDATE() AS date)
                    THEN 1 ELSE 0 END
    ) bd;
END;
