                            WHEN 'TEXAS'      THEN 'TX' WHEN 'TX' THEN 'TX'
                            ELSE UPPER(LEFT(LTRIM(RTRIM(s.State)), 2))
                        END
                END
        FROM src s
    )
    UPDATE tgt
    SET
        -- PASS-THROUGH (non-masked)
        tgt.ClassID = i.ClassID,
        tgt.ClassName = i.ClassName,
        tgt.Location = i.Location,
        tgt.ClassAddress = i.ClassAddress,
        tgt.Room = i.Room,
