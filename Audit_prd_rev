/* ===========================
   WEEKLY PACK PROC (DEV exact)
   =========================== */
CREATE OR ALTER PROCEDURE dbo.usp_Email_Weekly_Audit_Pack
    @ProfileName SYSNAME,
    @Recipients  NVARCHAR(MAX),
    @WeekStart   DATE = NULL,
    @WeekEnd     DATE = NULL,
    @MaxRowsPerSection INT = 200
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @utcToday DATE = CONVERT(DATE, SYSUTCDATETIME());

    IF @WeekStart IS NULL
    BEGIN
        DECLARE @dow INT = (DATEPART(WEEKDAY, @utcToday) + @@DATEFIRST - 2) % 7; -- 0=Mon
        SET @WeekStart = DATEADD(DAY, -@dow, @utcToday);
    END

    IF @WeekEnd IS NULL
        SET @WeekEnd = DATEADD(DAY, 7, @WeekStart);

    DECLARE @StartDT DATETIME2(7) = CAST(@WeekStart AS DATETIME2(7));
    DECLARE @EndDT   DATETIME2(7) = CAST(@WeekEnd   AS DATETIME2(7));

    DECLARE @style NVARCHAR(MAX) = N'
<style>
  body{font-family:Segoe UI, Arial; font-size:10pt;}
  table{border-collapse:collapse; width:100%;}
  th,td{border:1px solid #cfcfcf; padding:6px; vertical-align:top; word-break:break-word;}
  th{background:#f3f3f3;}
</style>';

    DECLARE @html NVARCHAR(MAX) =
        @style
      + N'<h2>Weekly Audit Pack - TERA</h2>'
      + N'<p><b>Window (UTC):</b> ' + CONVERT(NVARCHAR(10), @WeekStart, 120)
      + N' to ' + CONVERT(NVARCHAR(10), @WeekEnd, 120) + N'</p>';

    DECLARE @rows NVARCHAR(MAX) = N'';

    /* SECTION 1: Failed Logins (LGIF) - Human-ish */
    SELECT @rows = ISNULL((
        SELECT TOP (@MaxRowsPerSection)
            N'<tr><td>' + CONVERT(NVARCHAR(19), event_time, 120) + N'</td>'
          + N'<td>' + ISNULL(server_principal_name,N'') + N'</td>'
          + N'<td>' + ISNULL(client_ip,N'') + N'</td>'
          + N'<td>' + ISNULL(application_name,N'') + N'</td>'
          + N'<td>' + LEFT(REPLACE(REPLACE(ISNULL(statement,N''),CHAR(13),' '),CHAR(10),' '), 400) + N'</td></tr>'
        FROM dbo.v_Audit_All
        WHERE event_time >= @StartDT AND event_time < @EndDT
          AND action_id = 'LGIF'
          AND ISNULL(server_principal_name,N'') <> N''
          AND server_principal_name NOT LIKE 'svc%'
          AND server_principal_name NOT LIKE 'NT SERVICE\%'
        ORDER BY event_time DESC
        FOR XML PATH(''), TYPE
    ).value('.','nvarchar(max)'), N'');

    SET @html += N'<h3>Failed Logins (Human)</h3>'
      + CASE WHEN LEN(@rows)=0
             THEN N'<p><b>No failed logins found in this window.</b></p>'
             ELSE N'<table><tr><th>event_time</th><th>login</th><th>client_ip</th><th>application</th><th>message</th></tr>'
               + @rows + N'</table>' END;

    /* SECTION 2: Table Drops (DR) */
    SET @rows = N'';
    SELECT @rows = ISNULL((
        SELECT TOP (@MaxRowsPerSection)
            N'<tr><td>' + CONVERT(NVARCHAR(19), event_time, 120) + N'</td>'
          + N'<td>' + ISNULL(server_principal_name,N'') + N'</td>'
          + N'<td>' + ISNULL(database_name,N'') + N'</td>'
          + N'<td>' + ISNULL(schema_name,N'') + N'.' + ISNULL(object_name,N'') + N'</td>'
          + N'<td>' + ISNULL(client_ip,N'') + N'</td>'
          + N'<td>' + ISNULL(application_name,N'') + N'</td>'
          + N'<td>' + LEFT(REPLACE(REPLACE(ISNULL(statement,N''),CHAR(13),' '),CHAR(10),' '), 400) + N'</td></tr>'
        FROM dbo.v_Audit_All
        WHERE event_time >= @StartDT AND event_time < @EndDT
          AND action_id = 'DR'
        ORDER BY event_time DESC
        FOR XML PATH(''), TYPE
    ).value('.','nvarchar(max)'), N'');

    SET @html += N'<h3>Table / Object Drops</h3>'
      + CASE WHEN LEN(@rows)=0
             THEN N'<p><b>No drop events found in this window.</b></p>'
             ELSE N'<table><tr><th>event_time</th><th>login</th><th>db</th><th>object</th><th>client_ip</th><th>application</th><th>statement</th></tr>'
               + @rows + N'</table>' END;

    /* TRUNCATE TABLE (TR) */
    SET @rows = N'';
    SELECT @rows = ISNULL((
        SELECT TOP (@MaxRowsPerSection)
            N'<tr><td>' + CONVERT(NVARCHAR(19), event_time, 120) + N'</td>'
          + N'<td>' + ISNULL(server_principal_name,N'') + N'</td>'
          + N'<td>' + ISNULL(database_name,N'') + N'</td>'
          + N'<td>' + ISNULL(schema_name,N'') + N'.' + ISNULL(object_name,N'') + N'</td>'
          + N'<td>' + ISNULL(client_ip,N'') + N'</td>'
          + N'<td>' + ISNULL(application_name,N'') + N'</td>'
          + N'<td>' + LEFT(REPLACE(REPLACE(ISNULL(statement,N''),CHAR(13),' '),CHAR(10),' '), 400) + N'</td></tr>'
        FROM dbo.v_Audit_All
        WHERE event_time >= @StartDT AND event_time < @EndDT
          AND action_id = 'TR'
        ORDER BY event_time DESC
        FOR XML PATH(''), TYPE
    ).value('.','nvarchar(max)'), N'');

    SET @html += N'<h3>TRUNCATE TABLE Events (HIGH RISK)</h3>'
      + CASE WHEN LEN(@rows)=0
             THEN N'<p><b>No TRUNCATE TABLE events found in this window.</b></p>'
             ELSE N'<table><tr><th>event_time</th><th>login</th><th>db</th><th>object</th><th>client_ip</th><th>application</th><th>statement</th></tr>'
               + @rows + N'</table>' END;

    /* Potential Export */
    SET @rows = N'';
    SELECT @rows = ISNULL((
        SELECT TOP (@MaxRowsPerSection)
            N'<tr>'
          + N'<td>' + CONVERT(NVARCHAR(19), event_time_utc, 120) + N'</td>'
          + N'<td><b>' + ISNULL(severity,N'') + N'</b></td>'
          + N'<td>' + ISNULL(login_name,N'') + N'</td>'
          + N'<td>' + ISNULL(application_name,N'') + N'</td>'
          + N'<td>' + ISNULL(client_hostname,N'') + N'</td>'
          + N'<td>' + ISNULL(CAST(row_count AS NVARCHAR(20)), N'') + N'</td>'
          + N'<td>' + LEFT(REPLACE(REPLACE(ISNULL(statement_snippet,N''),CHAR(13),' '),CHAR(10),' '), 800) + N'</td>'
          + N'</tr>'
        FROM dbo.v_Report_PotentialExport
        WHERE event_time_utc >= @StartDT AND event_time_utc < @EndDT
        ORDER BY
            CASE severity WHEN 'HIGH' THEN 1 WHEN 'MEDIUM' THEN 2 WHEN 'LOW' THEN 3 ELSE 9 END,
            event_time_utc DESC
        FOR XML PATH(''), TYPE
    ).value('.','nvarchar(max)'), N'');

    SET @html += N'<h3>Potential Export / Data Leakage Signals</h3>'
      + N'<p>Signals include high row-count extracts and export-like query patterns (FOR JSON/XML, OPENROWSET/BULK, etc.).</p>'
      + CASE WHEN LEN(@rows)=0
             THEN N'<p><b>No potential export signals found in this window.</b></p>'
             ELSE N'<table><tr>'
                + N'<th>event_time_utc</th><th>severity</th><th>login</th><th>application</th><th>host</th><th>row_count</th><th>statement_snippet</th>'
                + N'</tr>' + @rows + N'</table>' END;

    /* SELECT Activity */
    SET @rows = N'';
    SELECT @rows = ISNULL((
        SELECT TOP (@MaxRowsPerSection)
            N'<tr><td>' + CONVERT(NVARCHAR(19), event_time, 120) + N'</td>'
          + N'<td>' + ISNULL(server_principal_name,N'') + N'</td>'
          + N'<td>' + ISNULL(database_name,N'') + N'</td>'
          + N'<td>' + ISNULL(schema_name,N'') + N'.' + ISNULL(object_name,N'') + N'</td>'
          + N'<td>' + ISNULL(client_ip,N'') + N'</td>'
          + N'<td>' + ISNULL(application_name,N'') + N'</td>'
          + N'<td>' + LEFT(REPLACE(REPLACE(ISNULL(statement,N''),CHAR(13),' '),CHAR(10),' '), 400) + N'</td></tr>'
        FROM dbo.v_Audit_All
        WHERE event_time >= @StartDT AND event_time < @EndDT
          AND action_id = 'SL'
          AND database_name = 'TERA'
        ORDER BY event_time DESC
        FOR XML PATH(''), TYPE
    ).value('.','nvarchar(max)'), N'');

    SET @html += N'<h3>SELECT Activity (SL) - TERA</h3>'
      + CASE WHEN LEN(@rows)=0
             THEN N'<p><b>No SELECT events found in this window.</b></p>'
             ELSE N'<table><tr><th>event_time</th><th>login</th><th>db</th><th>object</th><th>client_ip</th><th>application</th><th>statement</th></tr>'
               + @rows + N'</table>' END;

    IF @html IS NULL OR LEN(@html) < 300
        SET @html = @style + N'<h2>Weekly Audit Pack - TERA</h2><p>No audit events matched filters in this window.</p>';

    DECLARE @subject NVARCHAR(200) =
      N'Weekly Audit Pack - TERA (' + CONVERT(NVARCHAR(10), @WeekStart, 120) + N' to ' + CONVERT(NVARCHAR(10), @WeekEnd, 120) + N')';

    EXEC msdb.dbo.sp_send_dbmail
      @profile_name = @ProfileName,
      @recipients   = @Recipients,
      @subject      = @subject,
      @body         = @html,
      @body_format  = 'HTML';
END
GO

