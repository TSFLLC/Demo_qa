CREATE OR ALTER VIEW dbo.v_Report_PotentialExport
AS
WITH x AS
(
    SELECT CAST(event_data AS XML) AS xdata
    FROM sys.fn_xe_file_target_read_file(
        N'R:\SQLAudit\TERA\XE_TERA_ExportSignals*.xel',
        NULL, NULL, NULL
    )
),
raw AS
(
    SELECT
        xdata.value('(event/@timestamp)[1]','datetime2(7)') AS event_time_utc,
        xdata.value('(event/data[@name="row_count"]/value)[1]','bigint') AS row_count,
        xdata.value('(event/action[@name="username"]/value)[1]','nvarchar(256)') AS login_name,
        xdata.value('(event/action[@name="client_app_name"]/value)[1]','nvarchar(256)') AS application_name,
        xdata.value('(event/action[@name="client_hostname"]/value)[1]','nvarchar(256)') AS client_hostname,
        xdata.value('(event/action[@name="client_connection_id"]/value)[1]','uniqueidentifier') AS client_connection_id,
        xdata.value('(event/action[@name="database_name"]/value)[1]','nvarchar(256)') AS database_name,
        xdata.value('(event/action[@name="sql_text"]/value)[1]','nvarchar(max)') AS sql_text
    FROM x
)
SELECT
    event_time_utc,
    login_name,
    application_name,
    client_hostname,
    client_connection_id,
    row_count,
    CASE
        WHEN sql_text LIKE '%FOR JSON%' OR sql_text LIKE '%FOR XML%' THEN 'HIGH'
        WHEN sql_text LIKE '%OPENROWSET%' OR sql_text LIKE '%xp_cmdshell%' OR sql_text LIKE '%BULK%' THEN 'HIGH'
        WHEN row_count >= 10000 THEN 'HIGH'
        WHEN row_count BETWEEN 1000 AND 9999 THEN 'MEDIUM'
        ELSE 'LOW'
    END AS severity,
    LEFT(REPLACE(REPLACE(sql_text, CHAR(13),' '), CHAR(10),' '), 1200) AS statement_snippet
FROM raw
WHERE database_name = 'TERA'
  AND ISNULL(login_name,'') <> ''
  AND login_name NOT LIKE 'svc%'
  AND login_name NOT LIKE 'NT SERVICE\%'
  AND NOT EXISTS (SELECT 1 FROM dbo.Audit_ExcludeLogins e WHERE e.login_name = raw.login_name);
GO

