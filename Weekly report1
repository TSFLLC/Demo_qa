3) Weekly Summary Stored Procedure (exec metrics + trends)
USE [TERA];
GO

CREATE OR ALTER PROCEDURE dbo.usp_Weekly_Audit_Summary
    @WeekStart DATE = NULL,     -- if NULL, auto: Monday of current week (UTC)
    @WeekEnd   DATE = NULL      -- if NULL, WeekStart + 7
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @utcToday DATE = CONVERT(DATE, SYSUTCDATETIME());

    -- Default WeekStart = Monday (UTC)
    IF @WeekStart IS NULL
    BEGIN
        DECLARE @dow INT = (DATEPART(WEEKDAY, @utcToday) + @@DATEFIRST - 2) % 7;  -- 0=Mon
        SET @WeekStart = DATEADD(DAY, -@dow, @utcToday);
    END

    IF @WeekEnd IS NULL
        SET @WeekEnd = DATEADD(DAY, 7, @WeekStart);

    DECLARE @StartDT DATETIME2(7) = CAST(@WeekStart AS DATETIME2(7));
    DECLARE @EndDT   DATETIME2(7) = CAST(@WeekEnd   AS DATETIME2(7));

    /* 0) Refresh AD cache to keep Tech/Business accurate */
    EXEC dbo.usp_Refresh_AuditUserCategoryCache @LookbackHours = 168;

    /* 1) Executive metrics */
    ;WITH phi AS
    (
      SELECT
        a.event_time,
        a.server_principal_name AS login_name,
        COALESCE(c.category,'Unknown') AS user_category,
        a.application_name,
        a.client_ip,
        a.schema_name,
        a.object_name,
        LOWER(a.statement) AS stmt_l
      FROM dbo.v_Audit_PHI_Selects a
      LEFT JOIN dbo.Audit_UserCategoryCache c ON c.login_name = a.server_principal_name
      WHERE a.event_time >= @StartDT AND a.event_time < @EndDT
        AND a.server_principal_name NOT LIKE 'svc%'
        AND a.server_principal_name NOT LIKE 'NT SERVICE\%'
        AND a.server_principal_name NOT IN (SELECT login_name FROM dbo.Audit_ExcludeLogins)
    ),
    hits AS
    (
      SELECT
        p.*,
        CASE WHEN p.stmt_l LIKE '% where %' THEN 1 ELSE 0 END AS has_where,
        sk.keyword AS matched_keyword,
        CASE
          WHEN p.user_category IN ('Business','Unknown') AND sk.keyword IN ('SSN','DEA','DEANumber') THEN 'HIGH'
          WHEN sk.keyword IN ('SSN','DEA','DEANumber')
               AND (p.stmt_l LIKE '% like %' OR p.stmt_l LIKE '% in (%' OR p.stmt_l LIKE '% between %' OR p.stmt_l LIKE '%>=%' OR p.stmt_l LIKE '%<=%')
               THEN 'HIGH'
          WHEN p.user_category IN ('Business','Unknown')
               AND sk.keyword IN ('DOB','DateOfBirth','Email','EmailAddress','Phone','PhoneNumber','Mobile','Cell',
                                  'FirstName','LastName','FullName','PatientName','Patient_First_Name','Patient_Last_Name')
               THEN 'MEDIUM'
          WHEN p.user_category = 'Tech' AND sk.keyword IN ('SSN','DEA','DEANumber') THEN 'MEDIUM'
          WHEN p.user_category = 'Tech'
               AND sk.keyword IN ('DOB','DateOfBirth','Email','EmailAddress','Phone','PhoneNumber','Mobile','Cell',
                                  'FirstName','LastName','FullName','PatientName','Patient_First_Name','Patient_Last_Name')
               THEN 'LOW'
          ELSE 'MEDIUM'
        END AS severity
      FROM phi p
      OUTER APPLY
      (
        SELECT TOP (1) keyword
        FROM dbo.Audit_SensitiveKeywords
        WHERE p.stmt_l LIKE '% where %'
          AND p.stmt_l LIKE '%' + LOWER(keyword) + '%'
        ORDER BY keyword
      ) sk
      WHERE p.stmt_l LIKE '% where %' AND sk.keyword IS NOT NULL
    )
    SELECT
      'ExecutiveSummary' AS Section,
      COUNT(*) AS Total_PHI_WhereSensitive,
      SUM(CASE WHEN severity='HIGH' THEN 1 ELSE 0 END) AS High_Count,
      SUM(CASE WHEN user_category='Business' THEN 1 ELSE 0 END) AS Business_Count,
      SUM(CASE WHEN user_category='Tech' THEN 1 ELSE 0 END) AS Tech_Count,
      SUM(CASE WHEN user_category='Unknown' THEN 1 ELSE 0 END) AS Unknown_Count
    FROM hits;

    /* 2) Top offenders (users) */
    ;WITH hits AS
    (
      SELECT
        a.event_time,
        a.server_principal_name AS login_name,
        COALESCE(c.category,'Unknown') AS user_category,
        LOWER(a.statement) AS stmt_l,
        sk.keyword AS matched_keyword,
        CASE
          WHEN COALESCE(c.category,'Unknown') IN ('Business','Unknown') AND sk.keyword IN ('SSN','DEA','DEANumber') THEN 'HIGH'
          WHEN COALESCE(c.category,'Unknown') = 'Tech' AND sk.keyword IN ('SSN','DEA','DEANumber') THEN 'MEDIUM'
          ELSE 'MEDIUM'
        END AS severity
      FROM dbo.v_Audit_PHI_Selects a
      LEFT JOIN dbo.Audit_UserCategoryCache c ON c.login_name = a.server_principal_name
      OUTER APPLY
      (
        SELECT TOP (1) keyword
        FROM dbo.Audit_SensitiveKeywords
        WHERE LOWER(a.statement) LIKE '% where %'
          AND LOWER(a.statement) LIKE '%' + LOWER(keyword) + '%'
        ORDER BY keyword
      ) sk
      WHERE a.event_time >= @StartDT AND a.event_time < @EndDT
        AND a.server_principal_name NOT LIKE 'svc%'
        AND a.server_principal_name NOT LIKE 'NT SERVICE\%'
        AND a.server_principal_name NOT IN (SELECT login_name FROM dbo.Audit_ExcludeLogins)
        AND LOWER(a.statement) LIKE '% where %'
        AND sk.keyword IS NOT NULL
    )
    SELECT TOP (20)
      'TopUsers' AS Section,
      user_category,
      login_name,
      COUNT(*) AS Events,
      SUM(CASE WHEN severity='HIGH' THEN 1 ELSE 0 END) AS HighEvents
    FROM hits
    GROUP BY user_category, login_name
    ORDER BY HighEvents DESC, Events DESC;

    /* 3) Failed logins (human-only) */
    SELECT
      'FailedLogins' AS Section,
      *
    FROM dbo.v_Audit_FailedLogins_Human
    WHERE event_time >= @StartDT AND event_time < @EndDT
    ORDER BY event_time DESC;

    /* 4) Table drops */
    SELECT
      'TableDrops' AS Section,
      *
    FROM dbo.v_Audit_TableDrops
    WHERE event_time >= @StartDT AND event_time < @EndDT
    ORDER BY event_time DESC;
END
GO


+++++++++++++++++++//4) Weekly Audit Pack Email Procedure (one email, multiple sections)+++++++++++++++++++++++

USE [TERA];
GO

 ALTER PROCEDURE dbo.usp_Email_Weekly_Audit_Pack
    @ProfileName SYSNAME,
    @Recipients  NVARCHAR(MAX),
    @WeekStart   DATE = NULL,
    @WeekEnd     DATE = NULL,
    @MaxRowsPerSection INT = 200
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @utcToday DATE = CONVERT(DATE, SYSUTCDATETIME());

    -- Default week start = Monday (UTC)
    IF @WeekStart IS NULL
    BEGIN
        DECLARE @dow INT = (DATEPART(WEEKDAY, @utcToday) + @@DATEFIRST - 2) % 7; -- 0=Mon
        SET @WeekStart = DATEADD(DAY, -@dow, @utcToday);
    END

    IF @WeekEnd IS NULL
        SET @WeekEnd = DATEADD(DAY, 7, @WeekStart);

    DECLARE @StartDT DATETIME2(7) = CAST(@WeekStart AS DATETIME2(7));
    DECLARE @EndDT   DATETIME2(7) = CAST(@WeekEnd   AS DATETIME2(7));

    DECLARE @style NVARCHAR(MAX) = N'
<style>
  body{font-family:Segoe UI, Arial; font-size:10pt;}
  table{border-collapse:collapse; width:100%;}
  th,td{border:1px solid #cfcfcf; padding:6px; vertical-align:top; word-break:break-word;}
  th{background:#f3f3f3;}
</style>';

    DECLARE @html NVARCHAR(MAX) =
        @style
      + N'<h2>Weekly Audit Pack - TERA</h2>'
      + N'<p><b>Window (UTC):</b> ' + CONVERT(NVARCHAR(10), @WeekStart, 120)
      + N' to ' + CONVERT(NVARCHAR(10), @WeekEnd, 120) + N'</p>';

    /* =======================================================
       SECTION 1: Failed Logins (LGIF) - Human-ish
       ======================================================= */
    DECLARE @rows NVARCHAR(MAX) = N'';

    SELECT @rows = ISNULL((
        SELECT TOP (@MaxRowsPerSection)
            N'<tr><td>' + CONVERT(NVARCHAR(19), event_time, 120) + N'</td>'
          + N'<td>' + ISNULL(server_principal_name,N'') + N'</td>'
          + N'<td>' + ISNULL(client_ip,N'') + N'</td>'
          + N'<td>' + ISNULL(application_name,N'') + N'</td>'
          + N'<td>' + LEFT(REPLACE(REPLACE(ISNULL(statement,N''),CHAR(13),' '),CHAR(10),' '), 400) + N'</td></tr>'
        FROM dbo.v_Audit_All
        WHERE event_time >= @StartDT AND event_time < @EndDT
          AND action_id = 'LGIF'
          AND ISNULL(server_principal_name,N'') <> N''
          AND server_principal_name NOT LIKE 'svc%'
          AND server_principal_name NOT LIKE 'NT SERVICE\%'
        ORDER BY event_time DESC
        FOR XML PATH(''), TYPE
    ).value('.','nvarchar(max)'), N'');

    SET @html += N'<h3>Failed Logins (Human)</h3>'
      + CASE WHEN LEN(@rows)=0
             THEN N'<p><b>No failed logins found in this window.</b></p>'
             ELSE N'<table><tr><th>event_time</th><th>login</th><th>client_ip</th><th>application</th><th>message</th></tr>'
               + @rows + N'</table>' END;

    /* =======================================================
       SECTION 2: Table Drops (DR)
       ======================================================= */
    SET @rows = N'';

    SELECT @rows = ISNULL((
        SELECT TOP (@MaxRowsPerSection)
            N'<tr><td>' + CONVERT(NVARCHAR(19), event_time, 120) + N'</td>'
          + N'<td>' + ISNULL(server_principal_name,N'') + N'</td>'
          + N'<td>' + ISNULL(database_name,N'') + N'</td>'
          + N'<td>' + ISNULL(schema_name,N'') + N'.' + ISNULL(object_name,N'') + N'</td>'
          + N'<td>' + ISNULL(client_ip,N'') + N'</td>'
          + N'<td>' + ISNULL(application_name,N'') + N'</td>'
          + N'<td>' + LEFT(REPLACE(REPLACE(ISNULL(statement,N''),CHAR(13),' '),CHAR(10),' '), 400) + N'</td></tr>'
        FROM dbo.v_Audit_All
        WHERE event_time >= @StartDT AND event_time < @EndDT
          AND action_id = 'DR'
        ORDER BY event_time DESC
        FOR XML PATH(''), TYPE
    ).value('.','nvarchar(max)'), N'');

    SET @html += N'<h3>Table / Object Drops</h3>'
      + CASE WHEN LEN(@rows)=0
             THEN N'<p><b>No drop events found in this window.</b></p>'
             ELSE N'<table><tr><th>event_time</th><th>login</th><th>db</th><th>object</th><th>client_ip</th><th>application</th><th>statement</th></tr>'
               + @rows + N'</table>' END;

/* =======================================================
   SECTION: TRUNCATE TABLE (TR) – HIGH RISK
   ======================================================= */
SET @rows = N'';

SELECT @rows = ISNULL((
    SELECT TOP (@MaxRowsPerSection)
        N'<tr><td>' + CONVERT(NVARCHAR(19), event_time, 120) + N'</td>'
      + N'<td>' + ISNULL(server_principal_name,N'') + N'</td>'
      + N'<td>' + ISNULL(database_name,N'') + N'</td>'
      + N'<td>' + ISNULL(schema_name,N'') + N'.' + ISNULL(object_name,N'') + N'</td>'
      + N'<td>' + ISNULL(client_ip,N'') + N'</td>'
      + N'<td>' + ISNULL(application_name,N'') + N'</td>'
      + N'<td>' + LEFT(REPLACE(REPLACE(ISNULL(statement,N''),CHAR(13),' '),CHAR(10),' '), 400) + N'</td></tr>'
    FROM dbo.v_Audit_All
    WHERE event_time >= @StartDT AND event_time < @EndDT
      AND action_id = 'TR'
    ORDER BY event_time DESC
    FOR XML PATH(''), TYPE
).value('.','nvarchar(max)'), N'');

SET @html += N'<h3>TRUNCATE TABLE Events (HIGH RISK)</h3>'
  + CASE WHEN LEN(@rows)=0
         THEN N'<p><b>No TRUNCATE TABLE events found in this window.</b></p>'
         ELSE N'<table><tr><th>event_time</th><th>login</th><th>db</th><th>object</th><th>client_ip</th><th>application</th><th>statement</th></tr>'
           + @rows + N'</table>' END;

/* =======================================================
   SECTION: Potential Export / Data Leakage Signals
   Source: dbo.v_Report_PotentialExport (XE-based)
   ======================================================= */
SET @rows = N'';

SELECT @rows = ISNULL((
    SELECT TOP (@MaxRowsPerSection)
        N'<tr>'
      + N'<td>' + CONVERT(NVARCHAR(19), event_time_utc, 120) + N'</td>'
      + N'<td><b>' + ISNULL(severity,N'') + N'</b></td>'
      + N'<td>' + ISNULL(login_name,N'') + N'</td>'
      + N'<td>' + ISNULL(application_name,N'') + N'</td>'
      + N'<td>' + ISNULL(client_hostname,N'') + N'</td>'
      + N'<td>' + ISNULL(CAST(row_count AS NVARCHAR(20)), N'') + N'</td>'
      + N'<td>' + LEFT(REPLACE(REPLACE(ISNULL(statement_snippet,N''),CHAR(13),' '),CHAR(10),' '), 800) + N'</td>'
      + N'</tr>'
    FROM dbo.v_Report_PotentialExport
    WHERE event_time_utc >= @StartDT AND event_time_utc < @EndDT
    ORDER BY
        CASE severity WHEN 'HIGH' THEN 1 WHEN 'MEDIUM' THEN 2 WHEN 'LOW' THEN 3 ELSE 9 END,
        event_time_utc DESC
    FOR XML PATH(''), TYPE
).value('.','nvarchar(max)'), N'');

SET @html += N'<h3>Potential Export / Data Leakage Signals</h3>'
  + N'<p>Signals include high row-count extracts and export-like query patterns (FOR JSON/XML, OPENROWSET/BULK, etc.).</p>'
  + CASE WHEN LEN(@rows)=0
         THEN N'<p><b>No potential export signals found in this window.</b></p>'
         ELSE N'<table><tr>'
            + N'<th>event_time_utc</th>'
            + N'<th>severity</th>'
            + N'<th>login</th>'
            + N'<th>application</th>'
            + N'<th>host</th>'
            + N'<th>row_count</th>'
            + N'<th>statement_snippet</th>'
            + N'</tr>'
            + @rows + N'</table>' END;

    /* =======================================================
       SECTION 3: SELECT (SL) - show the SELECT events
       ======================================================= */
    SET @rows = N'';

    SELECT @rows = ISNULL((
        SELECT TOP (@MaxRowsPerSection)
            N'<tr><td>' + CONVERT(NVARCHAR(19), event_time, 120) + N'</td>'
          + N'<td>' + ISNULL(server_principal_name,N'') + N'</td>'
          + N'<td>' + ISNULL(database_name,N'') + N'</td>'
          + N'<td>' + ISNULL(schema_name,N'') + N'.' + ISNULL(object_name,N'') + N'</td>'
          + N'<td>' + ISNULL(client_ip,N'') + N'</td>'
          + N'<td>' + ISNULL(application_name,N'') + N'</td>'
          + N'<td>' + LEFT(REPLACE(REPLACE(ISNULL(statement,N''),CHAR(13),' '),CHAR(10),' '), 400) + N'</td></tr>'
        FROM dbo.v_Audit_All
        WHERE event_time >= @StartDT AND event_time < @EndDT
          AND action_id = 'SL'
          AND database_name = 'TERA'
        ORDER BY event_time DESC
        FOR XML PATH(''), TYPE
    ).value('.','nvarchar(max)'), N'');

    SET @html += N'<h3>SELECT Activity (SL) - TERA</h3>'
      + CASE WHEN LEN(@rows)=0
             THEN N'<p><b>No SELECT events found in this window.</b></p>'
             ELSE N'<table><tr><th>event_time</th><th>login</th><th>db</th><th>object</th><th>client_ip</th><th>application</th><th>statement</th></tr>'
               + @rows + N'</table>' END;

    /* Final safeguard: never send blank */
    IF @html IS NULL OR LEN(@html) < 300
        SET @html = @style + N'<h2>Weekly Audit Pack - TERA</h2><p>No audit events matched filters in this window.</p>';

    DECLARE @subject NVARCHAR(200) =
      N'Weekly Audit Pack - TERA (' + CONVERT(NVARCHAR(10), @WeekStart, 120) + N' to ' + CONVERT(NVARCHAR(10), @WeekEnd, 120) + N')';

    EXEC msdb.dbo.sp_send_dbmail
      @profile_name = @ProfileName,
      @recipients   = @Recipients,
      @subject      = @subject,
      @body         = @html,
      @body_format  = 'HTML';
END
GO




